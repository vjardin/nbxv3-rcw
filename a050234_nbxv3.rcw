/*
 * SPDX-License-Identifier: BSD-3-Clause
 *
 * Derived from the upstream NXP tree, lx2160asi/a050234.rcw:
 *   Copyright 2011-2016 Freescale Semiconductor, Inc
 *   Copyright 2017-2020 NXP
 * Modifications Copyright 2026 Free Mobile - Vincent Jardin
 *
 * Local nbxv3 variant of NXP's lx2160asi/a050234.rcw.
 *
 * Workaround for erratum A-050234 (PCIe elastic-buffer thresholds
 * cause spurious 8b/10b decode errors and Recovery-state entries).
 * Same fix as upstream: patch PEXaCR0/PEXaCR1 in each SerDes block.
 *
 * The main update vs upstream:
 * the LX2160A SerDes block exposes 4 PCIe sub-controllers
 * (A/B/C/D = PEXaCR0/CR1 indices 0/1/2/3) in the SD register window
 * at offsets 0x1200, 0x1240, 0x1280, 0x12C0. Only sub-controllers
 * that are enabled by the SerDes protocol's PCC0 configuration
 * (RM 26.4.1.28) are clocked.
 *
 *   SD1 (proto 13, 100GE only)         -> NO sub-controllers active
 *   SD2 (proto 7, PCIe.3 + PCIe.4)     -> A (idx 0) + C (idx 2) active;
 *                                         B (1) + D (3) power-gated
 *   SD3 (proto 3, PCIe.5 x4 + PCIe.6 x4) -> A (idx 0) + C (idx 2) active;
 *                                           B (1) + D (3) power-gated
 *
 * So this file:
 *   - SKIPS the SD1 block entirely (no PCIe).
 *   - Only writes PEXaCR0/CR1 indices (0) and (2) on SD2 and SD3.
 */

.pbi

#define SRDS_BASE 0x1eb0000 /* SerDes 2: PEXa = PCIe.3, PEXc = PCIe.4 */
#include <../serdes_28g.rcw>
write PEXaCR0(0), 0x20081004        /* PCIe.3 */
write PEXaCR0(2), 0x20081004        /* PCIe.4 */
write PEXaCR1(0), 0x00081004        /* PCIe.3 */
write PEXaCR1(2), 0x00081004        /* PCIe.4 */
#undef SRDS_BASE

#define SRDS_BASE 0x1ec0000 /* SerDes 3: PEXa = PCIe.5 x4, PEXc = PCIe.6 x4 */
#include <../serdes_28g.rcw>
write PEXaCR0(0), 0x20081004        /* PCIe.5 */
write PEXaCR0(2), 0x20081004        /* PCIe.6 */
write PEXaCR1(0), 0x00081004        /* PCIe.5 */
write PEXaCR1(2), 0x00081004        /* PCIe.6 */
#undef SRDS_BASE

.end
