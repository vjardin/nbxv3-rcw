/*
 * SPDX-License-Identifier: BSD-3-Clause
 * Copyright 2026 Free Mobile - Vincent Jardin
 *
 * Boot-time PBI identity: a build stamp for BL2, and a one-character
 * heartbeat on chip UART1 (0x021C0000), wired via UART1_SOUT / UART1_SIN
 *
 * This runs during the Service Processor's PBI phase, before any BL2 code
 * executes, and it emits two things:
 *
 *   1. The build stamp into DCFG SCRATCHRW13. BL2 reads it back and prints
 *      "Iliad nbxv3<c> RCW v.<date>".
 *
 *   2. The console heartbeat: the BOOT_ITER character then CRLF.
 *
 * UART clock at PBI time:
 *     platform_clock = SYSCLK * SYS_PLL_RAT / 2
 *                    = 100 MHz * 14 / 2 = 700 MHz
 *     uart_clock     = platform_clock / 4 = 175 MHz
 *
 * Baud divisor for 115200:
 *     divisor = 175e6 / (16 * 115200) = 94.9352
 *     IBRD    = 94          = 0x5E
 *     FBRD    = 0.9352 * 64 = 60 = 0x3C   (rounded)
 *
 * PL011 registers (UART1 base = 0x021C0000):
 *     UARTDR    offset 0x000  data register
 *     UARTFR    offset 0x018  flag register (TXFE bit 7, TXFF bit 5)
 *     UARTIBRD  offset 0x024  integer baud divisor
 *     UARTFBRD  offset 0x028  fractional baud divisor
 *     UARTLCR_H offset 0x02C  line control (bit 4 = FIFO, bits 6:5 = 11 for 8-bit)
 *     UARTCR    offset 0x030  control (bit 0 UARTEN, bit 8 TXE, bit 9 RXE)
 *
 * FIFO: the PL011 TX FIFO is 16 deep and the heartbeat is 3 bytes, so it
 * goes in one shot with no mid-drain. Only the final drain remains, and
 * it is not optional: if the FIFO is still draining when the SP
 * releases the cores, BL2's earliest output collides with it as a
 * deterministic ~30-byte garbage burst.
 */

/*
 * BUILD DATE: the low six BCD digits of the stamp, and D0 doubles as
 * the heartbeat character.
 */
#define BUILD_DATE_Y1   2       /* year decade          */
#define BUILD_DATE_Y0   6       /* year ones            */
#define BUILD_DATE_M1   0       /* month tens           */
#define BUILD_DATE_M0   8       /* month ones           */
#define BUILD_DATE_D1   2       /* day tens             */
#define BUILD_DATE_D0   0       /* day ones             */

#ifndef NBXV3_CARRIER_DIGIT
#define NBXV3_CARRIER_DIGIT F
#endif

#define NBXV3_STAMP_TAG   B

/*
 * DCFG SCRATCHRW13 layout, one 32-bit word:
 *
 *   31   28 27   24 23   16 15    8 7     0
 *  +-------+-------+-------+-------+-------+
 *  |CARRIER|  TAG  |  YY   |  MM   |  DD   |     all BCD
 *  +-------+-------+-------+-------+-------+
 *
 * e.g. NBV32 built on 2026-08-20 -> 0x2B260820, which BL2 renders as
 *      "Iliad nbxv32 RCW v.20260820".
 */
#define STAMP_(a, b, c, d, e, f, g, h)  0x##a##b##c##d##e##f##g##h
#define STAMP(a, b, c, d, e, f, g, h)   STAMP_(a, b, c, d, e, f, g, h)
#define BUILD_STAMP \
  STAMP(NBXV3_CARRIER_DIGIT, NBXV3_STAMP_TAG, \
        BUILD_DATE_Y1, BUILD_DATE_Y0, \
        BUILD_DATE_M1, BUILD_DATE_M0, BUILD_DATE_D1, BUILD_DATE_D0)

#define ASCII_0 0x30
#define ASCII_1 0x31
#define ASCII_2 0x32
#define ASCII_3 0x33
#define ASCII_4 0x34
#define ASCII_5 0x35
#define ASCII_6 0x36
#define ASCII_7 0x37
#define ASCII_8 0x38
#define ASCII_9 0x39
#define ASCII_A 0x41
#define ASCII_B 0x42
#define ASCII_C 0x43
#define ASCII_D 0x44
#define ASCII_E 0x45
#define ASCII_F 0x46
#define ASCII__(d) ASCII_##d
#define ASCII(d)   ASCII__(d)

/*
 * DCFG SCRATCHRW13. Offset 0x1FC + 13*4 = 0x230 (RM 9.3.1.47), DCFG base
 * 0x01e00000.
 */
#define DCFG_SCRATCHRW13  0x01e00230

#define UART(c) write 0x021C0000, c

.pbi

/* disable UART (ensures LCR_H/IBRD/FBRD land before enable) */
write 0x021C0030, 0x00000000

/* baud divisors */
write 0x021C0024, 0x0000005e
write 0x021C0028, 0x0000003c

/* LCR_H: FIFO enable (bit 4) | 8 bits (bits 6:5 = 11) = 0x70 */
write 0x021C002C, 0x00000070

/* enable: UARTEN (bit 0) | TXE (bit 8) | RXE (bit 9) = 0x301 */
write 0x021C0030, 0x00000301

/* Build stamp for BL2  */
write DCFG_SCRATCHRW13, BUILD_STAMP

/*
 * Heartbeat: the 1 character, then CRLF.
 *
 * CRLF costs 16 bytes but buys a clean line before ATF.
 */
UART(ASCII(BUILD_DATE_D0))
UART(0x0d)              /* CR */
UART(0x0a)              /* LF */

/*
 * Final drain. 3 bytes at 115200 baud = ~260 us. wait 0x0400 = 1024
 * cycles = ~1.5 ms, ~6x margin.
 *
 * XXX it is not optional.
 */
wait 0x0400

.end
