 *
 * Bring-up nbxv3 RCW: clocks active, all SerDes/IOs/PCIe stripped.
 *
 * Compile:
 *   qoriq-rcw -i rcw_nbxv3_withoutIOs_nor.rcw \
 *             -o rcw_nbxv3_withoutIOs_nor.bin \
 *             -I <qoriq-rcw>/data             \
 *             -I <upstream-rcw>/rcw/lx2160asi
 */

#include "rcw_nbxv3_common.rcwi"

/* SerDes configuration: ALL OFF.  */
SRDS_PLL_PD_PLL1=1
SRDS_PLL_PD_PLL2=1
SRDS_PLL_PD_PLL3=1
SRDS_PLL_PD_PLL4=1
SRDS_PLL_PD_PLL5=1
SRDS_PLL_PD_PLL6=1
SRDS_PRTCL_S1=0
SRDS_PRTCL_S2=0
SRDS_PRTCL_S3=0

/*
 * PBI: ECC-defense block
 *
 *   - ECCCR1/2/3 = 0       (RM 9.3.2.1) prevent IP-block ECC errors
 *                          from contributing to the ORed SBEE/MBEE
 *   - RSTRQMR1[MBEE_MSK]   (RM 4.3.1.2) mask MBEE_RR -> RESET_REQ_B
 *   - RSTRQSR1 w1c         clear any latched MBEE_RR
 */
.pbi
write 0x01e60010, 0x00020000        /* RSTRQMR1 MBEE_MSK = 1 */
write 0x01e60018, 0xffffffff        /* RSTRQSR1 w1c          */
write 0x01e00520, 0x00000000        /* ECCCR1 = 0            */
write 0x01e00524, 0x00000000        /* ECCCR2 = 0            */
write 0x01e00528, 0x00000000        /* ECCCR3 = 0            */
.end

